# Reference only. Set real values in Vercel's server-side environment settings.
# Never commit real keys, paste them in chat, or use a VITE_ prefix for secrets.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
VIRUSTOTAL_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Paste the COMPLETE existing service-account JSON as a sensitive env value.
# Preserve JSON escaping of the private key; do not set Render's file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
DEBUG=false
SEED_MOCK_DATA=false
VIRUSTOTAL_SUBMIT_UNKNOWN_URLS=false
URL_REPUTATION_PROVIDER=disabled
URL_RENDER_ENABLED=false
# Required: match Vercel's configured container port and the existing Dockerfile.
# Vercel otherwise expects port 80; this application defaults to 10000.
PORT=10000
