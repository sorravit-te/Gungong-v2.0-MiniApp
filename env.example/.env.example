# Google Gemini AI
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional MINI App Service Messages (not the bot channel/token above).
# Use a separate Developing build while the MINI App is unverified.
LINE_LOGIN_CHANNEL_ID=2008548759
# Opt-in acknowledgement after submission, using answer_completed_s_th.
LINE_SERVICE_MESSAGES_ENABLED=false
LINE_SERVICE_MESSAGES_ENVIRONMENT=developing
LINE_SERVICE_MESSAGES_PUBLISHED_APPROVED=false
LINE_MINIAPP_CHANNEL_ID=
LINE_MINIAPP_CHANNEL_SECRET=
LINE_MINIAPP_LIFF_ID=
LINE_SERVICE_MESSAGES_TEST_USER_IDS=

# Public build variables; never put secrets in VITE_* variables.
# Leave blank to keep the existing Published LIFF ID.
VITE_LIFF_ID=
VITE_LINE_ENDPOINT_URL=
VITE_LINE_SERVICE_MESSAGES_ENABLED=false

# VirusTotal
VIRUSTOTAL_API_KEY=

# Firebase / Firestore
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SEED_MOCK_DATA=false

# Application
DEBUG=true
