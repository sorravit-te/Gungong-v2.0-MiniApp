{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["sin1"],
  "trailingSlash": false,
  "services": {
    "web": {
      "root": "src/frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/health/:path*", "destination": { "service": "api" } },
    { "source": "/check-fraud/:path*", "destination": { "service": "api" } },
    { "source": "/analyze-message/:path*", "destination": { "service": "api" } },
    { "source": "/check-url/:path*", "destination": { "service": "api" } },
    { "source": "/check-bank/:path*", "destination": { "service": "api" } },
    { "source": "/check-phone/:path*", "destination": { "service": "api" } },
    { "source": "/history/:path*", "destination": { "service": "api" } },
    { "source": "/cache-entries/:path*", "destination": { "service": "api" } },
    { "source": "/cache-stats/:path*", "destination": { "service": "api" } },
    { "source": "/feedback/:path*", "destination": { "service": "api" } },
    { "source": "/webhook/:path*", "destination": { "service": "api" } },
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/docs/:path*", "destination": { "service": "api" } },
    { "source": "/redoc/:path*", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
