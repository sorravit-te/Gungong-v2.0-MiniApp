# ======================================================================
# GunGong (กันโกง) - Environment Configuration Template
# ======================================================================
#
# INSTRUCTIONS FOR REVIEWERS / คำแนะนำสำหรับผู้ตรวจสอบ:
#
# 1. Copy this file: cp .env.example .env.yaml
# 2. Fill in your own API credentials (see NOTICE_FOR_REVIEWERS.md)
# 3. NEVER commit your .env.yaml file to git!
#
# ======================================================================

# Google Gemini AI API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY: "your_gemini_api_key_here"

# LINE Messaging API Credentials
# Get yours at: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN: "your_line_channel_access_token_here"
LINE_CHANNEL_SECRET: "your_line_channel_secret_here"

# Firebase/Firestore Configuration
# Get yours at: https://console.firebase.google.com/
FIRESTORE_PROJECT_ID: "your_firestore_project_id_here"

# Firebase Service Account JSON (as a single-line string)
# Download from: Firebase Console → Project Settings → Service Accounts
# Convert to single line: cat service-account.json | jq -c
FIREBASE_CREDENTIALS_JSON: '{"type":"service_account","project_id":"your-project-id",...}'

# VirusTotal API Key (Optional - for URL malware scanning)
# Get yours at: https://www.virustotal.com/
# Leave empty if you don't have one (system will skip URL scanning)
VIRUSTOTAL_API_KEY: "your_virustotal_api_key_here_or_leave_empty"

# ======================================================================
# IMPORTANT SECURITY NOTES / ข้อควรระวัง:
# ======================================================================
#
# 1. NEVER share your actual API keys with anyone
#    ห้ามแชร์ API keys ของคุณให้ใครก็ตาม
#
# 2. NEVER commit .env.yaml to git (already in .gitignore)
#    ห้าม commit ไฟล์ .env.yaml ขึ้น git (มีใน .gitignore แล้ว)
#
# 3. If you accidentally expose keys, REVOKE them immediately
#    หากคีย์รั่วไหล ให้เพิกถอนทันที
#
# 4. For production, use environment variables or secret management
#    สำหรับ production ให้ใช้ environment variables หรือระบบจัดการ secrets
#
# ======================================================================
